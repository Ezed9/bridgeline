# Optional. With NO keys, crawlgate runs on deterministic stubs with zero network
# beyond the crawl itself -- and that is the ONLY configuration the security
# claim is measured in (SPEC.md R6).
#
# With both keys set, the planner and the extractor run on DIFFERENT providers,
# split by authority: the planner never sees page content, the extractor never
# sees the instruction.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
